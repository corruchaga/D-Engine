# URL base OpenAI-compatible, incluyendo /v1 si el proveedor lo usa.
# Ejemplos:
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
#   https://openrouter.ai/api/v1
#   http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# Clave del proveedor. Nunca la subas al repo.
LLM_API_KEY=sk-...

# Nombre del modelo tal como lo espera el endpoint.
# Ejemplos: deepseek-chat, gpt-4o-mini, llama3.2
LLM_MODEL=deepseek-chat
