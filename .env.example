# URL base OpenAI-compatible, incluyendo /v1 si el proveedor lo usa.
# DeepSeek: https://api.deepseek.com o https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com

# Clave del proveedor. Nunca la subas al repo.
LLM_API_KEY=

# Nombre del modelo tal como lo espera el endpoint.
LLM_MODEL=deepseek-flash

# Reintentos de propuesta ante rechazo de la puerta (bloques, ruta, materializacion o tsc).
# Default 2 (max 3 propuestas). Tope absoluto 5. Valores no numericos usan el default.
D_ENGINE_MAX_RETRIES=2

# Diario: ultimos commits del repo objetivo que tocaron los archivos seleccionados,
# inyectados como contexto barato (mensaje + stat, nunca el diff completo).
# Default 5 (tope absoluto 20). "0"/"false"/"off"/"no" desactiva el diario.
D_ENGINE_DIARY_COMMITS=5

# Techos de max_tokens por tipo de llamada LLM. En tiers medidos (p.ej. Groq) la
# cuota TPM cobra el maximo DECLARADO, no el consumido (HTTP 413 si te pasas).
# Defaults: selector 500, proposer 4096, audit 500.
# Topes absolutos: selector 4000, proposer 16384, audit 2000.
# Valores vacios, no numericos o <= 0 usan el default.
# Si una respuesta se trunca (finish_reason=length) se reintenta UNA vez con el
# techo de emergencia (min(tope absoluto, max(default, valor * 4))).
D_ENGINE_MAX_TOKENS_SELECTOR=500
D_ENGINE_MAX_TOKENS_PROPOSER=4096
D_ENGINE_MAX_TOKENS_AUDIT=500
