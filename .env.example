# URL base OpenAI-compatible, incluyendo /v1 si el proveedor lo usa.
# DeepSeek: https://api.deepseek.com o https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com

# Clave del proveedor. Nunca la subas al repo.
LLM_API_KEY=

# Nombre del modelo tal como lo espera el endpoint.
LLM_MODEL=deepseek-flash

# Reintentos de propuesta ante rechazo de la puerta (bloques, ruta, materializacion o tsc).
# Default 2 (max 3 propuestas). Tope absoluto 5. Valores no numericos usan el default.
D_ENGINE_MAX_RETRIES=2
